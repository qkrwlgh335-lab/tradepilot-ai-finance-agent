{
  "name": "kb-tradepilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KB TradePilot — 수출입 금융 지원 에이전트 (build-free static web app). No runtime npm deps; the browser app loads only local files + optional CDN model at runtime. @xenova/transformers is a DEV-ONLY tool used by scripts/build-embeddings.mjs to precompute product embeddings.",
  "scripts": {
    "start": "node scripts/start-demo.mjs",
    "test": "node --test test/*.test.mjs",
    "package": "node scripts/package.mjs",
    "package:submission": "node scripts/package-submission.mjs",
    "build:embeddings": "node scripts/build-embeddings.mjs",
    "build:scenario-embeddings": "node scripts/build-scenario-embeddings.mjs",
    "refresh:market-data": "node scripts/refresh-market-data.mjs",
    "refresh:country-indicators": "node scripts/refresh-country-indicators.mjs",
    "refresh:bilateral-trade": "node scripts/refresh-bilateral-trade.mjs",
    "eval": "node scripts/run-evaluation.mjs",
    "eval:scenario": "node scripts/evaluate-scenario-intent.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "proxy": "node proxy.mjs"
  },
  "devDependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
